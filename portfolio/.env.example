# Copy this file to .env and fill in the values for your environment.

# Core Django settings
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
DJANGO_TIME_ZONE=UTC

# Database (PostgreSQL / Neon URL; omit to use local db.sqlite3)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional SMTP configuration for email alerts and password resets
# (When EMAIL_HOST is omitted, emails are printed to the console.)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Expense Tracker <no-reply@your-domain.example.com>

